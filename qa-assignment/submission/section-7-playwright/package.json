{
  "name": "ablespace-qa-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright checks for AbleSpace staging: sign-in validation and adding a student",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2"
  }
}
