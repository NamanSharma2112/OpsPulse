# Base URL of the Go API, used for server-side calls. In Docker this is the
# internal hostname, which the browser cannot resolve.
OPSPULSE_API_URL=http://localhost:8080

# The API's public address, used for links the browser follows itself — the
# GitHub sign-in redirect.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional fallback for a server with no GitHub OAuth app configured. Signing
# in with GitHub sets an httpOnly session cookie instead, and that takes
# precedence over this.
#   curl -X POST $OPSPULSE_API_URL/v1/auth/login \
#     -H 'Content-Type: application/json' \
#     -d '{"email":"you@example.com","password":"..."}'
OPSPULSE_API_TOKEN=

# Optional: pin the dashboard to one project. Defaults to the first project
# the token can see.
OPSPULSE_PROJECT_ID=
