# Base URL of the Go API. Read on the server, so it is not exposed to browsers.
OPSPULSE_API_URL=http://localhost:8080

# Bearer token the dashboard uses to read the API. Obtain one with:
#   curl -X POST $OPSPULSE_API_URL/v1/auth/login \
#     -H 'Content-Type: application/json' \
#     -d '{"email":"you@example.com","password":"..."}'
# Interactive sign-in replaces this; see docs/architecture/overview.md.
OPSPULSE_API_TOKEN=

# Optional: pin the dashboard to one project. Defaults to the first project
# the token can see.
OPSPULSE_PROJECT_ID=
