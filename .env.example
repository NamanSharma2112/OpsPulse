# Copy to .env and adjust. docker-compose.yml reads these.

# --- Postgres -------------------------------------------------------------
POSTGRES_PASSWORD=opspulse
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
OPSPULSE_ENV=development
API_PORT=8080
LOG_LEVEL=info
# Required when OPSPULSE_ENV=production. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000

# Optional, for GitHub OAuth sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Dashboard ------------------------------------------------------------
WEB_PORT=3000
# Bearer token the dashboard reads the API with; see apps/web/.env.example.
OPSPULSE_API_TOKEN=
OPSPULSE_PROJECT_ID=
