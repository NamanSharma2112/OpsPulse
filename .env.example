# Copy to .env and adjust. docker-compose.yml reads these.

# --- Postgres -------------------------------------------------------------
POSTGRES_PASSWORD=opspulse
POSTGRES_PORT=5432

# --- API ------------------------------------------------------------------
OPSPULSE_ENV=development
API_PORT=8080
LOG_LEVEL=info
# Required when OPSPULSE_ENV=production. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:3000

# --- Sign in with GitHub --------------------------------------------------
# Create an OAuth app at https://github.com/settings/developers with the
# callback URL below. Without these, sign-in falls back to email + password
# and webhooks must be added by hand.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/v1/auth/github/callback

# Seals GitHub access tokens at rest. Required outside development.
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Where the browser lands after signing in.
APP_URL=http://localhost:3000

# The address GitHub delivers webhooks to. Must be reachable from the
# internet, so for local development use a tunnel (ngrok, cloudflared) and
# put its https URL here — localhost will not receive deliveries.
PUBLIC_API_URL=http://localhost:8080

# Marks the session cookie Secure. Required true in production.
SECURE_COOKIES=false

# GitHub Enterprise only.
# GITHUB_OAUTH_BASE=https://github.com
# GITHUB_API_BASE=https://api.github.com

# --- Dashboard ------------------------------------------------------------
WEB_PORT=3000
# Bearer token the dashboard reads the API with; see apps/web/.env.example.
OPSPULSE_API_TOKEN=
OPSPULSE_PROJECT_ID=
